# ============================================================================
# BLOOD BANK PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the real '.env' file containing secrets to version control.

# Application Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL / Cloud / Local)
# You may either configure discrete DB_* variables OR provide a single DATABASE_URL.
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=blood_bank_db
DB_PORT=3306

# Cloud Database SSL (Set to 'true' for AWS RDS, PlanetScale, Railway, Aiven, etc.)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Alternative: Single Connection String (takes precedence if provided)
# DATABASE_URL=mysql://your_database_user:your_database_password@your_database_host:3306/blood_bank_db?ssl={"rejectUnauthorized":true}

# Authentication & Security (§12 & §25)
JWT_SECRET=replace_this_with_a_secure_random_64_char_secret_in_production
JWT_EXPIRES_IN=8h

# CORS & Deployment Configuration (§17)
# Set to your production frontend URL (supports comma-separated multiple domains)
FRONTEND_URL=https://your-production-frontend.com
CORS_ORIGIN=https://your-production-frontend.com

# Optional Rate Limiting Overrides (§25)
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10

